#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:7 src/main.rs:62
msgid "Client Bluesky pour GNOME"
msgstr "Bluesky client for GNOME"

#. Traducteurs : mots-clés séparés par des points-virgules, sans traduire «
#. Tsubame ».
#: data/io.github.DocteurScience.Tsubame.desktop.in:6
msgid "Bluesky;réseau social;AT Protocol;microblog;"
msgstr "Bluesky;social network;AT Protocol;microblog;"

#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:9
msgid ""
"Tsubame est un client Bluesky natif pour le bureau GNOME. Les posts "
"s’affichent en cartes et la discussion s’ouvre dans un volet à côté du fil."
msgstr ""
"Tsubame is a native Bluesky client for the GNOME desktop. Posts are shown as"
" cards and the conversation opens in a pane next to the feed."

#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:16
msgid "DocteurScience"
msgstr "DocteurScience"

#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:36
msgid "Première version."
msgstr "First release."

#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:38
msgid ""
"Colonnes de cartes côte à côte, volet de discussion, une colonne en mobile"
msgstr ""
"Side-by-side card columns, conversation pane, a single column on mobile"

#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:39
msgid "Images, vidéos, citations et cartes de liens dans les posts"
msgstr "Images, videos, quotes and link cards in posts"

#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:40
msgid "Rédaction avec images, fils, brouillons, mentions et aperçu des liens"
msgstr "Writing with images, threads, drafts, mentions and link previews"

#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:41
msgid "Notifications regroupées et notifications du bureau"
msgstr "Grouped notifications and desktop notifications"

#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:42
msgid "Messagerie, recherche, signets, listes et profils"
msgstr "Messages, search, bookmarks, lists and profiles"

#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:43
msgid "Modération : masquer, bloquer, signaler, étiquettes de contenu"
msgstr "Moderation: mute, block, report, content labels"

#: data/io.github.DocteurScience.Tsubame.metainfo.xml.in:44
msgid "Connexion dans le navigateur, session gardée dans le trousseau"
msgstr "Sign-in in the browser, session kept in the keyring"

