<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.DocteurScience.Tsubame</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Tsubame</name>
  <summary>Client Bluesky pour GNOME</summary>
  <description>
    <p>
      Tsubame est un client Bluesky natif pour le bureau GNOME. Les posts
      s’affichent en cartes et la discussion s’ouvre dans un volet à côté
      du fil.
    </p>
  </description>
  <developer id="io.github.docteurscience">
    <name>DocteurScience</name>
  </developer>
  <launchable type="desktop-id">io.github.DocteurScience.Tsubame.desktop</launchable>
  <url type="homepage">https://github.com/DocteurScience/Tsubame</url>
  <url type="bugtracker">https://github.com/DocteurScience/Tsubame/issues</url>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">moderate</content_attribute>
  </content_rating>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <releases>
    <release version="0.1.0" date="2026-11-23" type="development">
      <description>
        <p>Première version.</p>
        <ul>
          <li>Colonnes de cartes côte à côte, volet de discussion, une colonne en mobile</li>
          <li>Images, vidéos, citations et cartes de liens dans les posts</li>
          <li>Rédaction avec images, fils, brouillons, mentions et aperçu des liens</li>
          <li>Notifications regroupées et notifications du bureau</li>
          <li>Messagerie, recherche, signets, listes et profils</li>
          <li>Modération : masquer, bloquer, signaler, étiquettes de contenu</li>
          <li>Connexion dans le navigateur, session gardée dans le trousseau</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
